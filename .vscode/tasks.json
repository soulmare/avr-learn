{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "AVR: Build active asm file",
            "type": "shell",
            "command": "avr-gcc",
            "args": [
                "-mmcu=atmega328p",
                "-x",
                "assembler-with-cpp",
                "-nostdlib",
                "-g",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}.elf",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true,
                "showReuseMessage": true
            },
            "problemMatcher": {
                "owner": "avr",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*):(\\d+):\\s+(Error|Warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "AVR: Start simulator",
            "type": "shell",
            "dependsOn": "AVR: Build active asm file",
            "command": "simavr",
            "args": [
                "-g",
                "-m",
                "atmega328p",
                "-f",
                "16000000",
                "${fileDirname}/${fileBasenameNoExtension}.elf"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "simavr",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": ".*"
                }
            }
        },
        {
            "label": "AVR: Stop simulator",
            "type": "shell",
            "command": "pkill -TERM -f \"simavr.*${fileDirname}/${fileBasenameNoExtension}.elf\" || true",
            "problemMatcher": []
        }
    ]
}
